  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Generate Admin Token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    // \"roleArn\": \"arn:aws:iam::624782989929:role/CrossAccountSTSRole\"\n    // \"roleArn\": \"arn:aws:iam::624782989929:role/CrossAccountSTSRoleV2\"\n    \"roleArn\": \"arn:aws:iam::624782989929:role/CrossAccountAccessCentralizedGateway905418476108\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/admin/tokens",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "tokens"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\n    const data = pm.response.json();\n    pm.collectionVariables.set('access_token', data.AuthenticationResult.AccessToken);\n    pm.collectionVariables.set('id_token', data.AuthenticationResult.IdToken);\n    pm.collectionVariables.set('refresh_token', data.AuthenticationResult.RefreshToken);\n    const expiresInMs = (data.AuthenticationResult.ExpiresIn || 3600) * 1000;\n    pm.collectionVariables.set('token_expiry', Date.now() + expiresInMs - 5000);\n    console.log('Access token refreshed, expires in', data.AuthenticationResult.ExpiresIn, 'seconds');\n} else {\n    console.error('Login failed:', pm.response.code, pm.response.text());\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-amz-json-1.1"
              },
              {
                "key": "X-Amz-Target",
                "value": "AWSCognitoIdentityProviderService.InitiateAuth"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"AuthFlow\": \"USER_PASSWORD_AUTH\",\n    \"ClientId\": \"{{client_id}}\",\n    \"AuthParameters\": {\n        \"USERNAME\": \"{{username}}\",\n        \"PASSWORD\": \"{{password}}\"\n    }\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://cognito-idp.us-east-1.amazonaws.com",
              "protocol": "https",
              "host": [
                "cognito-idp",
                "us-east-1",
                "amazonaws",
                "com"
              ]
            }
          },
          "response": []
        }
      ]
