{
  "name": "zk-sudo-admin-lambda",
  "version": "1.0.0",
  "description": "Admin Lambda for zk-sudo: issues and manages single-use enrolment bootstrap tokens.",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --minify --sourcemap=inline",
    "package": "npm run typecheck && npm run build && cd dist && rm -f ../function.zip && zip -q ../function.zip index.js && cd ..",
    "dev": "ts-node src/local.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.637.0",
    "@aws-sdk/client-iam": "^3.1117.0",
    "@aws-sdk/lib-dynamodb": "^3.637.0",
    "express": "^4.19.2",
    "prettier": "^3.9.6",
    "serverless-http": "^3.2.0",
    "vitest": "^4.1.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
